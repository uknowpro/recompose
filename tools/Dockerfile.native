# Build-time only. End users run the resulting executable without Docker/Python.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS builder
RUN apt-get update && apt-get install -y --no-install-recommends binutils && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY pyproject.toml LICENSE ./
COPY recompose ./recompose
COPY tests ./tests
COPY tools ./tools
RUN python -m pip install --no-cache-dir PyYAML==6.0.3 pyinstaller==6.22.3
RUN python -m unittest discover -s tests -q
RUN python tools/collect_native_licenses.py /licenses
RUN python -m PyInstaller --onefile --clean --noupx --name recompose \
    --paths /src --distpath /out --workpath /tmp/pyinstaller --specpath /tmp \
    --add-data /licenses:licenses --add-data /etc/ssl/certs/ca-certificates.crt:certificates tools/native_entrypoint.py
RUN /out/recompose --version
RUN cp -r /licenses /out/LICENSES && \
    python -m pip freeze > /out/BUILD-DEPENDENCIES.txt && \
    printf 'Linux x86_64; built on Debian 12, glibc 2.36; Python runtime embedded.\n' > /out/BUILD-INFO.txt && \
    cd /out && tar -czf recompose-linux-amd64.tar.gz recompose LICENSES BUILD-DEPENDENCIES.txt BUILD-INFO.txt && \
    sha256sum recompose recompose-linux-amd64.tar.gz > SHA256SUMS
FROM scratch AS export
COPY --from=builder /out/ /
